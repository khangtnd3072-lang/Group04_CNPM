          <mxGeometry height="135" width="138" x="-723" y="-159" as="geometry" />
        </mxCell>
        <mxCell id="Xo0Q58JkT5ogvpI0VWzH-6" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;" value="Manage Class &amp;amp; Subject" vertex="1">
          <mxGeometry height="138" width="137" x="-723" y="-564" as="geometry" />
        </mxCell>
        <mxCell id="FUi9rCjM3Zk_yAMaSlRt-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;h3 data-start=&quot;153&quot; data-end=&quot;191&quot;&gt;Manage Student Information&lt;/h3&gt;&lt;p data-start=&quot;193&quot; data-end=&quot;474&quot;&gt;This process receives student management information from the Administrator, performs operations such as adding, updating, or deleting student records, and stores the data in the student database. Student information is provided to other processes when required.&lt;/p&gt;&lt;h3 data-start=&quot;481&quot; data-end=&quot;515&quot;&gt;Manage Class &amp;amp; Subject&lt;/h3&gt;&lt;p data-start=&quot;517&quot; data-end=&quot;758&quot;&gt;This process receives class and subject management information from the Administrator, processes and stores class and subject data in the class and subject database to support attendance recording and reporting activities.&lt;/p&gt;&lt;h3 data-start=&quot;765&quot; data-end=&quot;794&quot;&gt;&amp;nbsp;Record Attendance&lt;/h3&gt;&lt;p data-start=&quot;796&quot; data-end=&quot;1029&quot;&gt;This process receives attendance data from the Lecturer and attendance information from the Student, records the attendance status (present or absent) of students, and stores the results in the attendance database.&lt;/p&gt;&lt;h3 data-start=&quot;1036&quot; data-end=&quot;1072&quot;&gt;&amp;nbsp;View Attendance &amp;amp; Report&lt;/h3&gt;&lt;p data-start=&quot;1074&quot; data-end=&quot;1328&quot;&gt;This process receives inquiry and report requests from Students, Lecturers, and the Administrator, aggregates attendance data from the database, and provides attendance results or summary reports to the corresponding external entities.&lt;/p&gt;" vertex="1">
          <mxGeometry height="298" width="905" x="-978" y="472" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
