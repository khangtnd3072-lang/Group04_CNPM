        <mxCell id="T-Cnm-jM9FtAvhGasjmD-3" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;" value="&lt;span style=&quot;font-size: 16px;&quot;&gt;Student Attendance System&lt;/span&gt;" vertex="1">
          <mxGeometry height="131" width="136" x="579" y="313" as="geometry" />
        </mxCell>
        <mxCell id="XzGGEhNg8_so4lbpaMJi-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;" value="&lt;h3 data-start=&quot;295&quot; data-end=&quot;339&quot;&gt;Process 0 – Student Attendance System&lt;/h3&gt;&lt;p data-start=&quot;341&quot; data-end=&quot;677&quot;&gt;Student Attendance System là hệ thống thực hiện quản lý và xử lý toàn bộ hoạt động điểm danh sinh viên. Hệ thống tiếp nhận thông tin điểm danh và yêu cầu tra cứu từ Student, Lecturer và Administrator; xử lý, lưu trữ dữ liệu điểm danh; đồng thời cung cấp kết quả điểm danh và các báo cáo tổng hợp cho các tác nhân liên quan.&lt;/p&gt;" vertex="1">
          <mxGeometry height="135" width="630" x="132" y="892" as="geometry" />
        </mxCell>
        <mxCell id="l05c7gWxZLDBTVWsR1n9-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;h3 data-start=&quot;156&quot; data-end=&quot;200&quot;&gt;Process 0 – Student Attendance System&lt;/h3&gt;&lt;p data-start=&quot;202&quot; data-end=&quot;570&quot;&gt;The Student Attendance System is responsible for managing and processing all student attendance activities. The system receives attendance information and inquiry requests from Students, Lecturers, and Administrators; processes and stores attendance data; and provides attendance results as well as summary reports to the relevant external entities.&lt;/p&gt;" vertex="1">
          <mxGeometry height="191" width="622" x="135" y="1033" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
